# Host development requires a local Postgres instance at DATABASE_URL.
# Copy this file to .env before running npm run dev.

# App runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
REQUEST_LOGGING=true
METRICS_ENABLED=true

# Infrastructure endpoints
DATABASE_URL=postgres://rekindle:rekindle@localhost:5432/rekindle
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000

# Seed behavior
SEED_ON_START=true
SEED_FILE=apps/api/seed-data.json
