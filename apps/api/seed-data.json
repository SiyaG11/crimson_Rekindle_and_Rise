  "posts": [
    { "id": "post-1", "authorId": "user-2", "body": "Tried a new route today and took it at my own pace.", "audience": "followers", "image": null, "createdAt": "2026-09-24T16:00:00.000Z" },
    { "id": "post-2", "authorId": "user-3", "body": "A reminder for fellow caregivers: specific offers of help are easier to accept.", "audience": "everyone", "image": null, "createdAt": "2026-09-25T15:00:00.000Z" },
    { "id": "post-3", "authorId": "user-4", "body": "The resource library has new transportation and peer-support links this week.", "audience": "everyone", "image": null, "createdAt": "2026-09-26T18:00:00.000Z" },
    { "id": "post-4", "authorId": "user-5", "body": "My small win: I made tea before opening my laptop.", "audience": "followers", "image": null, "createdAt": "2026-09-27T13:00:00.000Z" },
    { "id": "post-5", "authorId": "user-6", "body": "We found a routine that leaves room for a hard day.", "audience": "followers", "image": null, "createdAt": "2026-09-28T12:00:00.000Z" },
    { "id": "post-6", "authorId": "user-7", "body": "Community Circle helped me feel less alone this week.", "audience": "everyone", "image": null, "createdAt": "2026-09-29T19:00:00.000Z" },
    { "id": "post-7", "authorId": "user-8", "body": "Next Tuesday we will share tools for asking for accommodations.", "audience": "everyone", "image": null, "createdAt": "2026-09-30T17:00:00.000Z" },
    { "id": "post-8", "authorId": "user-9", "body": "A shared calendar reduced a lot of small stresses in our house.", "audience": "followers", "image": null, "createdAt": "2026-10-01T15:00:00.000Z" },
    { "id": "post-9", "authorId": "user-10", "body": "Looking forward to the outdoor accessibility meetup.", "audience": "followers", "image": null, "createdAt": "2026-10-02T14:00:00.000Z" },
    { "id": "post-10", "authorId": "user-1", "body": "Today I chose one useful thing and let that be enough.", "audience": "followers", "image": null, "createdAt": "2026-10-03T09:00:00.000Z" }
