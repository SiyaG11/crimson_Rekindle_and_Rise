  "journalEntries": [
    { "id": "entry-1", "userId": "user-1", "title": "A calmer appointment", "body": "I wrote down my questions before the appointment and felt more present.", "promptReference": "small-wins", "mood": "hopeful", "visibility": "private", "createdAt": "2026-09-20T15:00:00.000Z", "updatedAt": "2026-09-20T15:00:00.000Z" },
    { "id": "entry-2", "userId": "user-1", "title": "Making room for rest", "body": "A shorter day was still a full day. I am practicing leaving space in my calendar.", "promptReference": "daily-reflection", "mood": "steady", "visibility": "private", "createdAt": "2026-09-28T19:30:00.000Z", "updatedAt": "2026-09-28T19:30:00.000Z" },
    { "id": "entry-3", "userId": "user-2", "title": "Back on the trail", "body": "I walked the first half-mile with a friend and stopped before I was tired.", "promptReference": "body-check-in", "mood": "grateful", "visibility": "private", "createdAt": "2026-09-22T17:00:00.000Z", "updatedAt": "2026-09-22T17:00:00.000Z" },
    { "id": "entry-4", "userId": "user-3", "title": "A question I can ask", "body": "I can ask what support is useful today instead of guessing.", "promptReference": "caregiver-reflection", "mood": "steady", "visibility": "private", "createdAt": "2026-09-24T13:00:00.000Z", "updatedAt": "2026-09-24T13:00:00.000Z" },
    { "id": "entry-5", "userId": "user-4", "title": "Welcoming new faces", "body": "The resource workshop had a good mix of questions and quiet moments.", "promptReference": "volunteer-notes", "mood": "grateful", "visibility": "private", "createdAt": "2026-09-25T20:00:00.000Z", "updatedAt": "2026-09-25T20:00:00.000Z" },
    { "id": "entry-6", "userId": "user-5", "title": "Sketchbook break", "body": "Ten minutes of drawing helped my thoughts slow down.", "promptReference": "daily-reflection", "mood": "hopeful", "visibility": "private", "createdAt": "2026-09-26T16:00:00.000Z", "updatedAt": "2026-09-26T16:00:00.000Z" },
    { "id": "entry-7", "userId": "user-6", "title": "Useful routine", "body": "We made the morning plan together, one task at a time.", "promptReference": "caregiver-reflection", "mood": "steady", "visibility": "private", "createdAt": "2026-09-27T14:00:00.000Z", "updatedAt": "2026-09-27T14:00:00.000Z" },
    { "id": "entry-8", "userId": "user-7", "title": "Circle takeaway", "body": "Someone said progress can be quiet. I want to remember that.", "promptReference": "community-reflection", "mood": "grateful", "visibility": "private", "createdAt": "2026-09-28T18:00:00.000Z", "updatedAt": "2026-09-28T18:00:00.000Z" },
    { "id": "entry-9", "userId": "user-8", "title": "Facilitation note", "body": "Pauses gave people time to answer in their own way.", "promptReference": "volunteer-notes", "mood": "steady", "visibility": "private", "createdAt": "2026-09-29T16:00:00.000Z", "updatedAt": "2026-09-29T16:00:00.000Z" },
    { "id": "entry-10", "userId": "user-9", "title": "Preparing without rushing", "body": "A simple checklist made the week feel less crowded.", "promptReference": "caregiver-reflection", "mood": "hopeful", "visibility": "private", "createdAt": "2026-09-30T14:00:00.000Z", "updatedAt": "2026-09-30T14:00:00.000Z" },
    { "id": "entry-11", "userId": "user-10", "title": "Fresh air", "body": "I sat outside for lunch and noticed the weather changing.", "promptReference": "daily-reflection", "mood": "grateful", "visibility": "private", "createdAt": "2026-10-01T17:00:00.000Z", "updatedAt": "2026-10-01T17:00:00.000Z" }
